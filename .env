# ============================================================
# OLLAMA (Modelo de Linguagem / IA)
# ============================================================
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:1.5b
OLLAMA_KEEP_ALIVE=30m

# ============================================================
# WHISPER (Transcrição de Voz para Texto)
# ============================================================
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_LANGUAGE=pt

# ============================================================
# DETECÇÃO DE PALAVRA-CHAVE (Wake Word)
# ============================================================
WAKE_WORD=jarvis
# 0.40 é um bom equilíbrio; suba se houver falsos-positivos com ruído da sala
WAKE_THRESHOLD=0.40

# ============================================================
# CONFIGURAÇÕES DE ÁUDIO E MICROFONE
# ============================================================
# -1 = microfone padrão do Windows. Rode test_microfone.py para ver os
# índices disponíveis caso precise forçar um dispositivo específico.
AUDIO_DEVICE_INDEX=-1
AUDIO_SAMPLE_RATE=16000
# Sensibilidade ajustada para detectar voz normal e tolerar fala pausada
# (SILENCE_SECONDS maior = espera mais em silêncio antes de considerar que
# você terminou de falar; suba ainda mais se costuma pausar entre palavras)
SILENCE_THRESHOLD=60
SILENCE_SECONDS=2.0
MAX_RECORD_SECONDS=12.0
SAVE_AUDIO=true

# ============================================================
# PIPER (Síntese de Voz / Resposta Falada)
# ============================================================
PIPER_MODEL=models/piper/pt_BR-faber-medium.onnx
PIPER_EXECUTABLE=models/piper/piper.exe

# ============================================================
# LOGS E AVISOS
# ============================================================
HF_HUB_DISABLE_SYMLINKS_WARNING=1
PYTHONWARNINGS=ignore

# Captura de voz adaptativa
MIN_SPEECH_SECONDS=0.35
PRE_ROLL_SECONDS=0.35
# Sobe/desce a sensibilidade do "isso é fala ou é silêncio?" (padrão 2.2x
# o ruído ambiente). Se estiver cortando fala baixinha, baixe pra ~1.6.
SILENCE_MULTIPLIER=2.2
